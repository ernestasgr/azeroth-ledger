#!/bin/sh
# Refuse staged files over 5,000 tokens. Enable with: git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel)
for python in "$root/.venv/Scripts/python" "$root/.venv/bin/python" python3 python; do
    if command -v "$python" >/dev/null 2>&1; then
        exec "$python" "$root/tools/check_file_size.py"
    fi
done
echo "pre-commit: no Python found; create .venv (see AGENTS.md)" >&2
exit 1
